# Official OpenAI (Responses API)
SKILLPILOT_PROVIDER=responses
SKILLPILOT_MODEL=gpt-5.6-terra
SKILLPILOT_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key

# Optional: low, medium, high, xhigh, or max
# SKILLPILOT_REASONING=medium

# For a compatible gateway, change provider to chat, then set its model and URL.
# Local Ollama example: http://localhost:11434/v1 (no API key required)
